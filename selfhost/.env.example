# The settings of the Compose install. install.sh copies this file to .env and fills in the address
# and every secret; keep .env private and never commit it. A key changed here after the first start
# doesn't match the database any more, so leave them as they are.

# The address people open Tamari at. Supabase is served under the same address (/auth/v1, ...).
APP_URL=http://localhost:13390
# The port on this machine. Behind a reverse proxy with TLS, point the proxy at it.
HTTP_PORT=13390

# Filled in by install.sh: random values, and the two API keys signed with JWT_SECRET (10 years).
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
REALTIME_SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=

# Email for sign-in codes. While these are empty, nobody gets a code by email: the owner signs in
# with the link install.sh prints, and other people can't sign in until these are set. After a
# change, run `docker compose up -d` in this folder.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The address the mail comes from, such as tamari@example.com.
SMTP_FROM=
