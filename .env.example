# Copy to .env (Bun loads it), or set these in Vercel. `supabase start` prints local values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Mints the service accounts' sessions; never reaches space code or the browser.
SUPABASE_SECRET_KEY=
# The two service accounts (bun run supabase:setup creates them). The defaults are fine.
# MISO_SPACES_EMAIL=miso-spaces@example.com
# MISO_VAULT_EMAIL=miso-vault@example.com
# PORT=13380
