{
  "name": "tamari",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Tamari: a shell for company apps, with its spaces (workspaces/, spaces.json) in one repo.",
  "workspaces": [
    "packages/*",
    "app/vendor/dto-core"
  ],
  "scripts": {
    "dev": "bun app/dev.ts",
    "build": "bun app/build.ts",
    "start": "bun app/dev.ts --no-build",
    "typecheck": "tsc --noEmit -p app",
    "test": "bun test app packages cli scripts/publish-public",
    "supabase:setup": "bun scripts/supabase-setup.ts",
    "postinstall": "bun scripts/install-spaces.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@miso/caller": "workspace:*",
    "@miso/dto-core": "workspace:*",
    "@miso/store": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.116.0",
    "@tabler/icons-react": "^3.40.0",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "devalue": "^5.6.4",
    "hono": "^4.12.26",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/culori": "^4.0.1",
    "culori": "^4.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
